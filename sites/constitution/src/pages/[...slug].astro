---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PrevNext from '../components/PrevNext.astro';
import { nav, type NavItem } from '../components/Sidebar.astro';

// Flatten the sidebar's nav tree into a single ordered list, so prev/next
// is always derived from the same source as the sidebar itself rather than
// a second hand-maintained array that can drift out of sync (see
// aegis-initiative/aegis-initiative#66). Only leaf items are included:
// every group's own slug duplicates its first child's slug (e.g. the
// "Constitution" group and its "Preamble" child both point at
// /constitution/) -- including both would put that page in navOrder twice
// and make it point at itself as its own "next".
function flattenNav(items: NavItem[]): { slug: string; label: string }[] {
  return items.flatMap((item) =>
    item.items ? flattenNav(item.items) : [{ slug: item.slug, label: item.label }]
  );
}

const navOrder = flattenNav(nav);

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id;

// Build breadcrumbs
const parts = slug.split('/');
const section = parts[0];
const sectionLabels: Record<string, string> = {
  constitution: 'Constitution',
  doctrine: 'Doctrine',
  principles: 'Principles',
  protocols: 'Protocols',
  about: 'About',
  contact: 'Contact',
  showcase: 'Showcase',
  releases: 'Releases',
};

const breadcrumbs = [];
if (sectionLabels[section]) {
  // Section index pages show just the section name
  if (parts.length === 1 || (parts.length === 2 && parts[1] === 'index')) {
    breadcrumbs.push({ label: sectionLabels[section] });
  } else {
    breadcrumbs.push({ label: sectionLabels[section], href: `/${section}/` });
    breadcrumbs.push({ label: entry.data.title });
  }
}

// Compute prev/next
const navIdx = navOrder.findIndex((n) => n.slug === slug);
const prev = navIdx > 0 ? { label: navOrder[navIdx - 1].label, href: `/${navOrder[navIdx - 1].slug}/` } : undefined;
const next = navIdx >= 0 && navIdx < navOrder.length - 1 ? { label: navOrder[navIdx + 1].label, href: `/${navOrder[navIdx + 1].slug}/` } : undefined;
---

<DocLayout title={entry.data.title} description={entry.data.description}>
  {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} slot="breadcrumb" />}
  <h1>{entry.data.title}</h1>
  <Content />
  <PrevNext prev={prev} next={next} />
</DocLayout>
